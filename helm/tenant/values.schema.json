{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tenant chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer", "environment", "envGroup", "regionRole", "storage", "quota", "network"],
  "definitions": {
    "labelValue": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$" },
    "cpu": { "type": "string", "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$" },
    "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
    "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
  },
  "properties": {
    "argocd": { "type": "object" },
    "customer": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$" },
    "environment": { "enum": ["dev", "stage", "uat", "prod"] },
    "envGroup": { "enum": ["devstage", "uat", "prod"] },
    "regionRole": { "enum": ["primary", "dr"] },
    "serviceAccounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "gsa"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,11}$" },
          "gsa": { "type": "string", "pattern": "^[a-z][a-z0-9-]+@[a-z][a-z0-9-]+\\.iam\\.gserviceaccount\\.com$" }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kmsKey", "diskType", "reclaimPolicy"],
      "properties": {
        "kmsKey": { "type": "string", "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$" },
        "diskType": { "enum": ["pd-balanced", "pd-ssd", "hyperdisk-balanced"] },
        "reclaimPolicy": { "enum": ["Retain", "Delete"] }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestsCpu", "requestsMemory", "limitsMemory", "pods", "persistentVolumeClaims", "requestsStorage"],
      "properties": {
        "requestsCpu": { "$ref": "#/definitions/cpu" },
        "requestsMemory": { "$ref": "#/definitions/memory" },
        "limitsMemory": { "$ref": "#/definitions/memory" },
        "pods": { "type": "integer", "minimum": 1 },
        "persistentVolumeClaims": { "type": "integer", "minimum": 0 },
        "requestsStorage": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
      }
    },
    "limitRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultRequest": { "type": "object", "properties": { "cpu": { "$ref": "#/definitions/cpu" }, "memory": { "$ref": "#/definitions/memory" } } },
        "defaultLimit": { "type": "object", "properties": { "memory": { "$ref": "#/definitions/memory" } } },
        "max": { "type": "object", "properties": { "cpu": { "$ref": "#/definitions/cpu" }, "memory": { "$ref": "#/definitions/memory" } } }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sqlCidrs"],
      "properties": {
        "sqlCidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "googleApisCidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "dnsCidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "ingressGatewayNamespace": { "type": "string" },
        "egressGatewayNamespace": { "type": "string" },
        "monitoringNamespace": { "type": "string" }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "injectionLabel": { "type": "object", "additionalProperties": { "type": "string" } },
        "jwt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "jwksUri"],
          "properties": { "issuer": { "type": "string", "format": "uri" }, "jwksUri": { "type": "string", "format": "uri" } }
        }
      }
    }
  }
}
