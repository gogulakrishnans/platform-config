{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example/schemas/customer.schema.json",
  "title": "CustomerConfig (customers/<customer>/customer.yaml)",
  "description": "Onboarding input. Only spec.region.primary is required; placement is written by the placement job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "cell": {
      "type": "object", "additionalProperties": false, "required": ["cluster", "sqlInstance"],
      "properties": {
        "cluster": { "type": "string", "pattern": "^(devstage|uat|prod)-[a-z0-9-]+-[0-9]{2}$" },
        "sqlInstance": { "type": "string", "pattern": "^sql-(nonprod|prod)-[a-z0-9-]+-[0-9]{2}$" },
        "drCluster": { "type": "string", "pattern": "^prod-[a-z0-9-]+-[0-9]{2}-dr$" }
      }
    }
  },
  "properties": {
    "apiVersion": { "const": "platform.example/v1" },
    "kind": { "const": "CustomerConfig" },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,18}[a-z0-9]$" } }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "accountId", "region"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "accountId": { "type": "string", "pattern": "^CUST-[0-9]{6}$" },
        "region": {
          "type": "object", "additionalProperties": false, "required": ["primary"],
          "properties": { "primary": { "type": "string", "pattern": "^[a-z]+-[a-z]+[0-9]$" } }
        },
        "options": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "isolation": { "enum": ["shared", "dedicated"], "default": "shared" },
            "dr": { "enum": ["warm-standby", "hot-standby"], "default": "warm-standby" },
            "edge": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "customCertificate": { "type": "boolean" },
                "customDomain": { "type": ["string", "null"], "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$" }
              }
            },
            "variantImages": { "type": "boolean", "default": false }
          }
        },
        "placement": {
          "description": "Written back by the placement job; never hand-edited. Keyed by environment group: dev and stage share the devstage cell and stay separate environments.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "dedicated": { "const": true, "description": "isolation: dedicated, placed by the dedicated-project pipeline" },
            "devstage": { "$ref": "#/$defs/cell" },
            "uat": { "$ref": "#/$defs/cell" },
            "prod": { "allOf": [{ "$ref": "#/$defs/cell" }, { "required": ["drCluster"] }] }
          }
        },
        "contacts": {
          "type": "object", "additionalProperties": false,
          "properties": { "technical": { "type": "string", "format": "email" } }
        }
      }
    }
  }
}
