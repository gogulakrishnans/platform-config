## Another Product Example (Different Infrastructure)

```yaml
# products/analytics-dashboard/product.yaml
# ════════════════════════════════════════════════════════════════════════════
# PRODUCT DEFINITION: analytics-dashboard
# ════════════════════════════════════════════════════════════════════════════

apiVersion: platform.company.io/v1
kind: ProductDefinition
metadata:
  name: analytics-dashboard
  labels:
    category: analytics
    tier: standard

spec:
  displayName: "Analytics Dashboard"
  description: "Real-time analytics and reporting dashboard"
  version: "1.8.0"
  
  runtime:
    type: cloud-run                     # Runs on Cloud Run, NOT GKE
    
    cloudRun:
      minInstances:
        dev: 0
        stage: 0
        uat: 1
        prod: 2
      maxInstances:
        dev: 2
        stage: 5
        uat: 10
        prod: 100
      cpu: "2"
      memory: "1Gi"
      concurrency: 80
      timeout: 300
      
  infrastructure:
    
    # NO Cloud SQL needed
    cloudSql:
      required: false
    
    # NO Redis needed
    redis:
      required: false
    
    # BigQuery IS required
    bigQuery:
      required: true
      datasets:
        - name: analytics
          location: US
          tables:
            - name: events
              partitioning:
                type: DAY
                field: event_timestamp
              clustering:
                - customer_id
                - event_type
            - name: aggregates_daily
              partitioning:
                type: DAY
                field: date
        - name: reporting
          location: US
          
    # Cloud Storage for exports
    storage:
      required: true
      buckets:
        - name: reports
          purpose: "Generated reports"
          lifecycle:
            deleteAfterDays: 180
        - name: imports
          purpose: "Data imports"
          lifecycle:
            deleteAfterDays: 7
    
    # Cloud Scheduler for report generation
    cloudScheduler:
      required: true
      jobs:
        - name: daily-report
          schedule: "0 6 * * *"
          timezone: "UTC"
        - name: weekly-summary
          schedule: "0 8 * * MON"
          timezone: "UTC"
    
    # NO Pub/Sub needed
    pubsub:
      required: false
    
    # NO KMS needed (no sensitive data encryption)
    kms:
      required: false
    
    secrets:
      required: true
      secrets:
        - name: looker-api-key
          description: "Looker Studio integration"
          optional: true
          
  networking:
    ingress:
      enabled: true
      public: true
      path: /dashboard
      
    egress:
      allowedDestinations:
        - bigquery.googleapis.com
        - storage.googleapis.com
        
  dependencies:
    required: []
    optional:
      - name: payment-api
        purpose: "Payment data for analytics"
        dataAccess: read-only
        
  compliance:
    pciDss: false
    dataClassification: internal
    encryptionRequired: false
    auditLogging: true
    
  cost:
    baseMonthly:
      dev: 20
      stage: 40
      uat: 60
      prod: 200
    perQueryTB: 5.00
