```sql
-- ============================================
-- TABLE CREATION WITH TENANT COLUMNS
-- ============================================

CREATE TABLE `shared-analytics.shared_analytics.events` (
  event_id STRING NOT NULL,
  tenant_id STRING NOT NULL,          -- Customer identifier
  environment STRING NOT NULL,         -- dev | stage | uat | prod
  event_type STRING,
  event_data JSON,
  created_at TIMESTAMP
)
PARTITION BY DATE(created_at)
CLUSTER BY tenant_id, environment;    -- Optimize queries by tenant

-- ============================================
-- ROW ACCESS POLICIES
-- ============================================

-- Policy: Acme Corp non-prod can see ALL Acme environments
CREATE ROW ACCESS POLICY acme_corp_nonprod_full_access
ON `shared-analytics.shared_analytics.events`
GRANT TO (
  'serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com',
  'serviceAccount:acme-corp-stage@shared-compute-nonprod.iam.gserviceaccount.com',
  'serviceAccount:acme-corp-uat@shared-compute-nonprod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'acme-corp');  -- Can see all environments

-- Policy: Acme Corp prod can see ONLY prod data
CREATE ROW ACCESS POLICY acme_corp_prod_strict
ON `shared-analytics.shared_analytics.events`
GRANT TO (
  'serviceAccount:acme-corp-prod@shared-compute-prod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'acme-corp' AND environment = 'prod');

-- Policy: Beta Industries non-prod can see ALL Beta environments
CREATE ROW ACCESS POLICY beta_ind_nonprod_full_access
ON `shared-analytics.shared_analytics.events`
GRANT TO (
  'serviceAccount:beta-ind-dev@shared-compute-nonprod.iam.gserviceaccount.com',
  'serviceAccount:beta-ind-stage@shared-compute-nonprod.iam.gserviceaccount.com'
