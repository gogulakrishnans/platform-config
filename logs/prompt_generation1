# ════════════════════════════════════════════════════════════════════════════
# BIGQUERY AUTHORIZED VIEWS
# ════════════════════════════════════════════════════════════════════════════

# Prod dataset (source of truth)
resource "google_bigquery_dataset" "prod" {
  dataset_id = "acme_corp_prod"
  project    = var.project_id
  location   = "US"

  # Authorize the dev view to access this dataset
  access {
    view {
      project_id = var.project_id
      dataset_id = google_bigquery_dataset.dev.dataset_id
      table_id   = "users_anonymized"
    }
  }
}

# Dev dataset
resource "google_bigquery_dataset" "dev" {
  dataset_id = "acme_corp_dev"
  project    = var.project_id
  location   = "US"
}

# Anonymized view in dev dataset
resource "google_bigquery_table" "users_anonymized_view" {
  dataset_id = google_bigquery_dataset.dev.dataset_id
  table_id   = "users_anonymized"
  project    = var.project_id

  view {
    query          = <<-SQL
      SELECT
        id,
        CONCAT('user_', CAST(id AS STRING), '@test.local') AS email,
        CONCAT('***-***-', RIGHT(phone, 4)) AS phone,
        CONCAT('XXX-XX-', RIGHT(ssn, 4)) AS ssn,
        account_type,
        status,
        created_at,
        updated_at
      FROM `${var.project_id}.acme_corp_prod.users`
      WHERE created_at >= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY)
    SQL
    use_legacy_sql = false
  }

  deletion_protection = false
}

# Grant dev service account access to view only
resource "google_bigquery_dataset_iam_member" "dev_access" {
  dataset_id = google_bigquery_dataset.dev.dataset_id
  project    = var.project_id
  role       = "roles/bigquery.dataViewer"
  member     = "serviceAccount:acme-corp-dev@${var.project_id}.iam.gserviceaccount.com"
}
