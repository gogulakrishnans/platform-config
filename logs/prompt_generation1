│   ┌─────────────────────────────────────────────────────────────────────┐  │
│   │ Table: users                                                        │  │
│   │ ┌──────────┬─────────────┬────────────┬──────────────┬───────────┐ │  │
│   │ │ id       │ tenant_id   │ environment│ email        │ name      │ │  │
│   │ ├──────────┼─────────────┼────────────┼──────────────┼───────────┤ │  │
│   │ │ 1        │ acme-corp   │ prod       │ john@acme    │ John      │ │  │
│   │ │ 2        │ acme-corp   │ dev        │ test@acme    │ Test      │ │  │
│   │ │ 3        │ beta-ind    │ prod       │ jane@beta    │ Jane      │ │  │
│   │ └──────────┴─────────────┴────────────┴──────────────┴───────────┘ │  │
│   └─────────────────────────────────────────────────────────────────────┘  │
│                                                                             │
│   Isolation: Row-Level Security (RLS) in PostgreSQL                        │
│   ─────────────────────────────────────────────────                        │
│   ALTER TABLE users ENABLE ROW LEVEL SECURITY;                             │
│                                                                             │
│   CREATE POLICY tenant_isolation ON users                                  │
│     USING (tenant_id = current_setting('app.tenant_id')                    │
│       AND environment = current_setting('app.environment'));               │
│                                                                             │
│   Application sets context:                                                │
│   SET app.tenant_id = 'acme-corp';                                        │
│   SET app.environment = 'prod';                                            │
│   SELECT * FROM users;  -- Only sees acme-corp prod rows                  │
│                                                                             │
│   Pros:                                     Cons:                          │
│   • Maximum cost efficiency               • Application MUST set context  │
│   • Single schema to manage               • Bug = cross-tenant data leak  │
│   • Easy cross-tenant analytics           • Performance at scale          │
│   • Simple backups                        • Compliance concerns           │
│                                                                             │
└─────────────────────────────────────────────────────────────────────────────┘
```

