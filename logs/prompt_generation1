### Terraform for Storage Transfer

```hcl
# ════════════════════════════════════════════════════════════════════════════
# GCS STORAGE TRANSFER SERVICE
# ════════════════════════════════════════════════════════════════════════════

resource "google_storage_transfer_job" "prod_to_dev_sync" {
  description = "Sync prod files to dev for acme-corp"
  project     = var.project_id

  transfer_spec {
    gcs_data_source {
      bucket_name = "platform-customer-data"
      path        = "acme-corp/prod/"
    }

    gcs_data_sink {
      bucket_name = "platform-customer-data"
      path        = "acme-corp/dev/"
    }

    # Only sync files modified in last 7 days
    object_conditions {
      min_time_elapsed_since_last_modification = "0s"
      max_time_elapsed_since_last_modification = "604800s"  # 7 days
      
      # Exclude sensitive files
      exclude_prefixes = [
        "acme-corp/prod/sensitive/",
        "acme-corp/prod/pii/"
      ]
    }

    transfer_options {
      overwrite_objects_already_existing_in_sink = true
      delete_objects_from_source_after_transfer  = false
    }
  }

  schedule {
    schedule_start_date {
      year  = 2026
      month = 1
      day   = 1
    }
    
    start_time_of_day {
      hours   = 3
      minutes = 0
      seconds = 0
      nanos   = 0
    }
    
    repeat_interval = "86400s"  # Daily
  }

  status = "ENABLED"
}
```

