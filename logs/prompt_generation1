## BigQuery: Row-Level Security

BigQuery natively supports row-level security, making shared datasets viable.

```sql
-- Create shared dataset
CREATE SCHEMA `platform-data.analytics`;

-- Create table with tenant column
CREATE TABLE `platform-data.analytics.events` (
  event_id STRING,
  tenant_id STRING,
  environment STRING,
  event_type STRING,
  event_data JSON,
  created_at TIMESTAMP
)
PARTITION BY DATE(created_at)
CLUSTER BY tenant_id, environment;

-- Create row access policy
CREATE ROW ACCESS POLICY tenant_filter
ON `platform-data.analytics.events`
GRANT TO ('serviceAccount:acme-corp-prod@platform.iam.gserviceaccount.com')
FILTER USING (tenant_id = 'acme-corp' AND environment = 'prod');

CREATE ROW ACCESS POLICY tenant_filter_dev
ON `platform-data.analytics.events`
GRANT TO ('serviceAccount:acme-corp-dev@platform.iam.gserviceaccount.com')
FILTER USING (tenant_id = 'acme-corp' AND environment IN ('dev', 'stage', 'uat'));
```

