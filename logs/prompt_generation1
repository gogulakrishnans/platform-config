### Terraform Implementation

```hcl
# ════════════════════════════════════════════════════════════════════════════
# CLOUD SQL: CLONE INSTANCE
# ════════════════════════════════════════════════════════════════════════════

# Production instance (source)
resource "google_sql_database_instance" "prod" {
  name             = "acme-corp-prod"
  database_version = "POSTGRES_15"
  region           = "us-east1"
  project          = var.project_id

  settings {
    tier = "db-custom-4-16384"
    
    backup_configuration {
      enabled                        = true
      point_in_time_recovery_enabled = true  # Required for cloning
      transaction_log_retention_days = 7
    }
  }
}

# Clone for dev environment
resource "google_sql_database_instance" "dev_clone" {
  name             = "acme-corp-dev"
  database_version = "POSTGRES_15"
  region           = "us-east1"
  project          = var.project_id

  clone {
    source_instance_name = google_sql_database_instance.prod.name
    # Optional: Clone from specific point in time
    # point_in_time = "2026-11-20T10:00:00.000Z"
  }

  settings {
    tier = "db-custom-2-8192"  # Smaller tier for dev
  }

  # Prevent accidental deletion
  deletion_protection = false  # Set to true in production
}
```

### gcloud CLI for On-Demand Cloning

```bash
# ════════════════════════════════════════════════════════════════════════════
# CLONE INSTANCE VIA GCLOUD
# ════════════════════════════════════════════════════════════════════════════

# Clone current state
gcloud sql instances clone acme-corp-prod acme-corp-dev-clone \
    --project=shared-sql-prod

# Clone from specific point in time
gcloud sql instances clone acme-corp-prod acme-corp-dev-clone \
    --project=shared-sql-prod \
    --point-in-time="2026-11-20T10:00:00.000Z"

# Clone takes ~1-5 minutes regardless of database size!
