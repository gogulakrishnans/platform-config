## Data Clone Tool Implementation

```python
#!/usr/bin/env python3
"""
Data Clone Tool - Copies and anonymizes production data to lower environments
"""

import os
import yaml
import hashlib
from typing import Dict, List, Any
from dataclasses import dataclass
from faker import Faker
import psycopg2
from psycopg2 import sql
from psycopg2.extras import execute_batch
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Initialize Faker with seed for deterministic output
fake = Faker()


@dataclass
class CloneConfig:
    tenant_id: str
    source_schema: str
    target_schemas: List[str]
    clone_tables: List[str]
    exclude_tables: List[str]
    date_filter_column: str
    date_filter_days: int
    max_rows_per_table: int
    anonymize_enabled: bool
    anonymize_rules: Dict


class DataCloneTool:
    
    def __init__(self):
        self.config = self._load_config()
        self.conn = self._connect_db()
        
        # Set seed for deterministic anonymization
        if self.config.anonymize_enabled:
            seed = self.config.anonymize_rules.get('settings', {}).get('seed', 'default')
            Faker.seed(hashlib.md5(seed.encode()).hexdigest())
    
    def _load_config(self) -> CloneConfig:
        """Load configuration from environment and config files"""
        
        # Load anonymization rules
        anonymize_rules = {}
        if os.environ.get('ANONYMIZE_ENABLED', 'false').lower() == 'true':
            config_path = os.environ.get('ANONYMIZE_CONFIG', '/config/anonymize-rules.yaml')
            with open(config_path, 'r') as f:
                anonymize_rules = yaml.safe_load(f)
        
        return CloneConfig(
            tenant_id=os.environ['TENANT_ID'],
            source_schema=os.environ['SOURCE_SCHEMA'],
            target_schemas=os.environ['TARGET_SCHEMAS'].split(','),
            clone_tables=os.environ['CLONE_TABLES'].split(','),
            exclude_tables=os.environ.get('EXCLUDE_TABLES', '').split(','),
            date_filter_column=os.environ.get('DATE_FILTER_COLUMN', 'created_at'),
            date_filter_days=int(os.environ.get('DATE_FILTER_DAYS', 30)),
            max_rows_per_table=int(os.environ.get('MAX_ROWS_PER_TABLE', 100000)),
            anonymize_enabled=os.environ.get('ANONYMIZE_ENABLED', 'false').lower() == 'true',
            anonymize_rules=anonymize_rules
        )
    
    def _connect_db(self):
        """Connect to database"""
        return psycopg2.connect(
            host=os.environ['DB_HOST'],
            port=os.environ.get('DB_PORT', 5432),
            dbname=os.environ['DB_NAME'],
            user=os.environ['DB_USER'],
            password=os.environ['DB_PASSWORD']
        )
    
    def _get_table_columns(self, schema: str, table: str) -> List[str]:
        """Get column names for a table"""
        with self.conn.cursor() as cur:
            cur.execute("""
                SELECT column_name 
                FROM information_schema.columns 
                WHERE table_schema = %s AND table_name = %s
                ORDER BY ordinal_position
            """, [schema, table])
            return [row[0] for row in cur.fetchall()]
    
    def _anonymize_value(self, table: str, column: str, value: Any, row_id: int) -> Any:
        """Anonymize a single value based on rules"""
        
        if value is None:
            return None
        
        rules = self.config.anonymize_rules.get('rules', {}).get(table, {})
        
        # Check if table should be preserved as-is
        if rules.get('preserve_all', False):
            return value
        
        # Check if column should be preserved
        if column in rules.get('preserve', []):
            return value
        
        # Find column rule
        column_rules = rules.get('columns', [])
        column_rule = next((r for r in column_rules if r['name'] == column), None)
        
        if not column_rule:
            return value  # No rule, preserve as-is
        
        method = column_rule['method']
        
        # Use row_id as seed for deterministic output
        fake.seed_instance(hash(f"{self.config.tenant_id}-{table}-{column}-{row_id}"))
        
        # Apply anonymization method
        if method == 'fake_email':
            return f"user_{row_id}@test.local"
        
        elif method == 'fake_phone':
            return f"555-000-{row_id % 10000:04d}"
        
        elif method == 'fake_first_name':
            return fake.first_name()
        
        elif method == 'fake_last_name':
            return f"User{row_id}"
        
        elif method == 'fake_name':
            return fake.name()
        
        elif method == 'fake_address':
            return f"{row_id} Test Street, Test City, TS 00000"
        
        elif method == 'hash_partial':
            prefix = column_rule.get('prefix', '')
            suffix = str(value)[-4:] if len(str(value)) >= 4 else str(value)
            return f"{prefix}{suffix}"
        
        elif method == 'hash':
            return hashlib.sha256(str(value).encode()).hexdigest()[:len(str(value))]
        
        elif method == 'static':
            return column_rule.get('value', '')
        
        elif method == 'null_out':
            return None
        
        elif method == 'anonymize_ip':
            # Keep first two octets, zero out rest
            parts = str(value).split('.')
            if len(parts) == 4:
                return f"{parts[0]}.{parts[1]}.0.0"
            return value
        
        elif method == 'randomize_date':
            import random
            from datetime import timedelta
            range_days = column_rule.get('range_days', 365)
            delta = timedelta(days=random.randint(-range_days, range_days))
            return value + delta
        
        else:
            logger.warning(f"Unknown anonymization method: {method}")
            return value
    
    def _extract_data(self, table: str) -> tuple:
        """Extract data from source schema"""
        
        columns = self._get_table_columns(self.config.source_schema, table)
        
        # Build query with filters
        query = sql.SQL("""
            SELECT {columns}
            FROM {schema}.{table}
            WHERE {date_column} >= CURRENT_DATE - INTERVAL '{days} days'
            ORDER BY {date_column} DESC
            LIMIT {limit}
        """).format(
            columns=sql.SQL(', ').join(sql.Identifier(c) for c in columns),
            schema=sql.Identifier(self.config.source_schema),
            table=sql.Identifier(table),
            date_column=sql.Identifier(self.config.date_filter_column),
            days=sql.Literal(self.config.date_filter_days),
            limit=sql.Literal(self.config.max_rows_per_table)
        )
        
        with self.conn.cursor() as cur:
            cur.execute(query)
            rows = cur.fetchall()
        
        logger.info(f"Extracted {len(rows)} rows from {self.config.source_schema}.{table}")
        return columns, rows
    
    def _transform_data(self, table: str, columns: List[str], rows: List[tuple]) -> List[tuple]:
        """Transform/anonymize data"""
        
        if not self.config.anonymize_enabled:
            return rows
        
        # Find id column index for deterministic anonymization
        id_col_idx = columns.index('id') if 'id' in columns else 0
        
        transformed = []
        for row in rows:
            row_id = row[id_col_idx]
            new_row = []
            
            for i, (col, val) in enumerate(zip(columns, row)):
                new_val = self._anonymize_value(table, col, val, row_id)
                new_row.append(new_val)
            
            transformed.append(tuple(new_row))
        
        logger.info(f"Transformed {len(transformed)} rows for {table}")
        return transformed
    
    def _load_data(self, target_schema: str, table: str, columns: List[str], rows: List[tuple]):
        """Load data into target schema"""
        
        with self.conn.cursor() as cur:
            # Truncate target table
            cur.execute(sql.SQL("TRUNCATE TABLE {schema}.{table} CASCADE").format(
                schema=sql.Identifier(target_schema),
                table=sql.Identifier(table)
            ))
            
            # Build insert statement
            insert_sql = sql.SQL("""
                INSERT INTO {schema}.{table} ({columns})
                VALUES ({placeholders})
            """).format(
                schema=sql.Identifier(target_schema),
                table=sql.Identifier(table),
                columns=sql.SQL(', ').join(sql.Identifier(c) for c in columns),
                placeholders=sql.SQL(', ').join(sql.Placeholder() for _ in columns)
            )
            
            # Batch insert
            execute_batch(cur, insert_sql, rows, page_size=1000)
            
            self.conn.commit()
        
        logger.info(f"Loaded {len(rows)} rows into {target_schema}.{table}")
    
    def clone_table(self, table: str):
        """Clone a single table to all target schemas"""
        
        logger.info(f"═══ Cloning table: {table} ═══")
        
        # Extract from source
        columns, rows = self._extract_data(table)
        
        if not rows:
            logger.warning(f"No data found in {self.config.source_schema}.{table}")
            return
        
        # Transform (anonymize)
        transformed_rows = self._transform_data(table, columns, rows)
        
        # Load to each target schema
        for target_schema in self.config.target_schemas:
            self._load_data(target_schema, table, columns, transformed_rows)
    
    def run(self):
        """Main execution"""
        
        logger.info(f"╔══════════════════════════════════════════════════════════════╗")
        logger.info(f"║ Data Clone Tool - {self.config.tenant_id}                    ║")
        logger.info(f"║ Source: {self.config.source_schema}                          ║")
        logger.info(f"║ Targets: {', '.join(self.config.target_schemas)}             ║")
        logger.info(f"╚══════════════════════════════════════════════════════════════╝")
        
        tables_to_clone = [t for t in self.config.clone_tables 
                          if t not in self.config.exclude_tables]
        
        logger.info(f"Tables to clone: {tables_to_clone}")
        
        for table in tables_to_clone:
            try:
                self.clone_table(table)
            except Exception as e:
                logger.error(f"Failed to clone table {table}: {e}")
                raise
        
        self.conn.close()
        
        logger.info("╔══════════════════════════════════════════════════════════════╗")
        logger.info("║ ✅ Data clone completed successfully!                        ║")
        logger.info("╚══════════════════════════════════════════════════════════════╝")


if __name__ == "__main__":
    tool = DataCloneTool()
    tool.run()
