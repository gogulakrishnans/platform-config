### Cloud Function Code (Python)

```python
# cloud_function/main.py
# ════════════════════════════════════════════════════════════════════════════
# CLOUD FUNCTION: CLONE AND SANITIZE DATABASE
# ════════════════════════════════════════════════════════════════════════════

import os
import json
import time
import functions_framework
from google.cloud import storage
from google.cloud.sql.connector import Connector
from googleapiclient import discovery
from google.auth import default

# Configuration
PROJECT_ID = os.environ['PROJECT_ID']
REGION = os.environ['REGION']
SANITIZATION_BUCKET = os.environ['SANITIZATION_BUCKET']
SANITIZATION_SCRIPT = os.environ['SANITIZATION_SCRIPT']


@functions_framework.http
def clone_and_sanitize(request):
    """
    Main entry point for Cloud Function.
    Clones a Cloud SQL instance and runs sanitization.
    """
    
    # Parse request
    request_json = request.get_json(silent=True)
    if not request_json:
        return json.dumps({"error": "No request body"}), 400
    
    customer_id = request_json.get('customer_id')
    source_instance = request_json.get('source_instance')
    target_instance = request_json.get('target_instance')
    target_tier = request_json.get('target_tier', 'db-custom-2-8192')
    
    print(f"Starting clone: {source_instance} -> {target_instance}")
    
    try:
        # Step 1: Delete existing clone if exists
        delete_instance_if_exists(target_instance)
        
        # Step 2: Clone the instance
        clone_instance(source_instance, target_instance, target_tier)
        
        # Step 3: Wait for clone to be ready
        wait_for_instance_ready(target_instance)
        
        # Step 4: Run sanitization script
        run_sanitization(target_instance, customer_id)
        
        # Step 5: Verify sanitization
        verify_sanitization(target_instance)
        
        return json.dumps({
            "status": "success",
            "message": f"Clone {target_instance} created and sanitized",
            "source": source_instance,
            "target": target_instance
        }), 200
        
    except Exception as e:
        print(f"Error: {str(e)}")
        return json.dumps({"error": str(e)}), 500


def get_sql_admin_service():
    """Get Cloud SQL Admin API service"""
    credentials, _ = default()
    return discovery.build('sqladmin', 'v1', credentials=credentials)


def delete_instance_if_exists(instance_name):
    """Delete instance if it exists"""
    service = get_sql_admin_service()
    
    try:
        # Check if instance exists
        service.instances().get(
            project=PROJECT_ID,
            instance=instance_name
        ).execute()
        
        print(f"Deleting existing instance: {instance_name}")
        
        # Delete instance
        operation = service.instances().delete(
            project=PROJECT_ID,
            instance=instance_name
        ).execute()
        
        # Wait for deletion
        wait_for_operation(operation['name'])
        print(f"Deleted instance: {instance_name}")
        
    except Exception as e:
        if 'HttpError 404' in str(e):
            print(f"Instance {instance_name} does not exist, skipping delete")
        else:
            raise


def clone_instance(source_instance, target_instance, target_tier):
    """Clone a Cloud SQL instance"""
    service = get_sql_admin_service()
    
    clone_request = {
        'cloneContext': {
            'destinationInstanceName': target_instance,
            'kind': 'sql#cloneContext'
        }
    }
    
    print(f"Cloning {source_instance} to {target_instance}")
    
    operation = service.instances().clone(
        project=PROJECT_ID,
        instance=source_instance,
        body=clone_request
    ).execute()
    
    # Wait for clone operation
    wait_for_operation(operation['name'])
    
    print(f"Clone operation completed")
    
    # Optionally resize the clone to smaller tier
    if target_tier:
        resize_instance(target_instance, target_tier)


def resize_instance(instance_name, tier):
    """Resize instance to specified tier"""
    service = get_sql_admin_service()
    
    patch_request = {
        'settings': {
            'tier': tier
        }
    }
    
    print(f"Resizing {instance_name} to {tier}")
    
    operation = service.instances().patch(
        project=PROJECT_ID,
        instance=instance_name,
        body=patch_request
    ).execute()
    
    wait_for_operation(operation['name'])
    print(f"Resize completed")


def wait_for_operation(operation_name):
    """Wait for a Cloud SQL operation to complete"""
    service = get_sql_admin_service()
    
    while True:
        result = service.operations().get(
            project=PROJECT_ID,
            operation=operation_name
        ).execute()
        
        if result['status'] == 'DONE':
            if 'error' in result:
                raise Exception(f"Operation failed: {result['error']}")
            return result
        
        print(f"Operation {operation_name} status: {result['status']}")
        time.sleep(30)


def wait_for_instance_ready(instance_name):
    """Wait for instance to be in RUNNABLE state"""
    service = get_sql_admin_service()
    
    while True:
        result = service.instances().get(
            project=PROJECT_ID,
            instance=instance_name
        ).execute()
        
        if result['state'] == 'RUNNABLE':
            print(f"Instance {instance_name} is ready")
            return
        
        print(f"Instance {instance_name} state: {result['state']}")
        time.sleep(30)


def run_sanitization(instance_name, customer_id):
    """Run sanitization SQL script on the cloned instance"""
    
    # Download sanitization script from GCS
    storage_client = storage.Client()
    bucket = storage_client.bucket(SANITIZATION_BUCKET)
    blob = bucket.blob(SANITIZATION_SCRIPT)
    sanitization_sql = blob.download_as_text()
    
    print(f"Running sanitization script on {instance_name}")
    
    # Connect to the cloned instance using Cloud SQL Connector
    connector = Connector()
    
    def getconn():
        return connector.connect(
            f"{PROJECT_ID}:{REGION}:{instance_name}",
            "pg8000",
            user="postgres",
            db="postgres",
            enable_iam_auth=True
        )
    
    conn = getconn()
    cursor = conn.cursor()
    
    try:
        # Execute sanitization script
        cursor.execute(sanitization_sql)
        conn.commit()
        print("Sanitization script executed successfully")
        
    finally:
        cursor.close()
        conn.close()
        connector.close()


def verify_sanitization(instance_name):
    """Verify that sanitization was successful"""
    
    connector = Connector()
    
    def getconn():
        return connector.connect(
            f"{PROJECT_ID}:{REGION}:{instance_name}",
            "pg8000",
            user="postgres",
            db="postgres",
            enable_iam_auth=True
        )
    
    conn = getconn()
    cursor = conn.cursor()
    
    try:
        # Check for clone metadata
        cursor.execute("""
            SELECT value FROM _clone_metadata WHERE key = 'sanitized'
        """)
        result = cursor.fetchone()
        
        if not result or result[0] != 'true':
            raise Exception("Sanitization verification failed: metadata not found")
        
        # Check no active sessions
        cursor.execute("SELECT COUNT(*) FROM sessions")
        session_count = cursor.fetchone()[0]
        
        if session_count > 0:
            raise Exception(f"Sanitization verification failed: {session_count} sessions still exist")
        
        # Check MFA disabled
        cursor.execute("SELECT COUNT(*) FROM users WHERE mfa_enabled = TRUE")
        mfa_count = cursor.fetchone()[0]
        
        if mfa_count > 0:
            raise Exception(f"Sanitization verification failed: {mfa_count} users still have MFA enabled")
        
        print("Sanitization verification passed")
        
    finally:
        cursor.close()
        conn.close()
        connector.close()
```

