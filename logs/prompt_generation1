## Sanitization SQL Script

```sql
-- ════════════════════════════════════════════════════════════════════════════
-- POST-CLONE SANITIZATION SCRIPT
-- Run immediately after Cloud SQL clone completes
-- ════════════════════════════════════════════════════════════════════════════

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ CONFIGURATION                                                           │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Known test password hash (bcrypt hash of "TestPassword123!")
-- Generate with: SELECT crypt('TestPassword123!', gen_salt('bf', 12));
\set TEST_PASSWORD_HASH '$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/X4.qE7f9eJmN/d/AS'

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 1: SANITIZE AUTHENTICATION CREDENTIALS                            │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Replace all password hashes with known test password
UPDATE users SET 
    password_hash = :'TEST_PASSWORD_HASH',
    password_salt = NULL,  -- Clear if separate salt column exists
    password_changed_at = NOW(),
    force_password_change = FALSE
WHERE password_hash IS NOT NULL;

-- Log sanitization
INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('password_reset', 'users', (SELECT COUNT(*) FROM users WHERE password_hash IS NOT NULL), NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 2: REMOVE MFA SECRETS                                             │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Clear all MFA data
UPDATE users SET
    mfa_enabled = FALSE,
    mfa_secret = NULL,
    mfa_backup_codes = NULL,
    mfa_recovery_key = NULL,
    mfa_verified_at = NULL
WHERE mfa_enabled = TRUE;

-- Clear MFA devices table if exists
TRUNCATE TABLE mfa_devices CASCADE;

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('mfa_cleared', 'users', (SELECT COUNT(*) FROM users), NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 3: TRUNCATE ALL TOKEN/SESSION TABLES                              │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Sessions
TRUNCATE TABLE sessions CASCADE;
TRUNCATE TABLE user_sessions CASCADE;

-- Auth tokens
TRUNCATE TABLE refresh_tokens CASCADE;
TRUNCATE TABLE access_tokens CASCADE;
TRUNCATE TABLE oauth_access_tokens CASCADE;
TRUNCATE TABLE oauth_refresh_tokens CASCADE;

-- Password reset / verification
TRUNCATE TABLE password_reset_tokens CASCADE;
TRUNCATE TABLE email_verification_tokens CASCADE;
TRUNCATE TABLE phone_verification_codes CASCADE;

-- Remember me / persistent login
TRUNCATE TABLE remember_tokens CASCADE;
TRUNCATE TABLE persistent_logins CASCADE;

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('tokens_truncated', 'all_token_tables', 0, NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 4: SANITIZE API KEYS                                              │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Replace API keys with clearly marked test keys
UPDATE api_keys SET
    key_hash = encode(sha256(('test_key_' || id::text)::bytea), 'hex'),
    key_prefix = 'TEST_',
    is_active = TRUE,
    last_used_at = NULL
WHERE key_hash IS NOT NULL;

-- Clear webhook secrets
UPDATE webhooks SET
    secret = encode(sha256(('test_webhook_' || id::text)::bytea), 'hex')
WHERE secret IS NOT NULL;

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('api_keys_replaced', 'api_keys', (SELECT COUNT(*) FROM api_keys), NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 5: CLEAR THIRD-PARTY INTEGRATION CREDENTIALS                      │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Clear OAuth tokens for third-party services
UPDATE user_oauth_connections SET
    access_token = NULL,
    refresh_token = NULL,
    token_expires_at = NULL,
    is_connected = FALSE;

-- Clear integration credentials
UPDATE integrations SET
    credentials = NULL,
    api_key = NULL,
    api_secret = NULL,
    access_token = NULL,
    is_active = FALSE;

-- Clear payment tokens (Stripe, etc.)
UPDATE payment_methods SET
    token = NULL,
    card_fingerprint = NULL,
    is_active = FALSE;

UPDATE customers SET
    stripe_customer_id = CONCAT('cus_test_', id::text),
    payment_method_id = NULL;

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('integrations_cleared', 'integrations', (SELECT COUNT(*) FROM integrations), NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 6: ANONYMIZE PII (Email, Phone, etc.)                             │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Anonymize emails (keep domain structure for testing)
UPDATE users SET
    email = CONCAT('user_', id::text, '@test.local'),
    email_verified = TRUE,
    email_verified_at = NOW();

-- Anonymize phone numbers
UPDATE users SET
    phone = CONCAT('+1-555-000-', LPAD(id::text, 4, '0')),
    phone_verified = FALSE,
    phone_verified_at = NULL
WHERE phone IS NOT NULL;

-- Anonymize names
UPDATE users SET
    first_name = CONCAT('Test', id::text),
    last_name = CONCAT('User', id::text),
    display_name = CONCAT('TestUser', id::text);

-- Anonymize addresses
UPDATE addresses SET
    line1 = CONCAT(id::text, ' Test Street'),
    line2 = NULL,
    city = 'Test City',
    state = 'TS',
    postal_code = '00000',
    country = 'US';

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('pii_anonymized', 'users', (SELECT COUNT(*) FROM users), NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 7: CREATE TEST ADMIN ACCOUNT                                      │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Insert or update a known test admin account for dev access
INSERT INTO users (
    id,
    email,
    password_hash,
    first_name,
    last_name,
    role,
    is_active,
    email_verified,
    created_at,
    updated_at
) VALUES (
    0,  -- Known ID
    'admin@test.local',
    :'TEST_PASSWORD_HASH',
    'Test',
    'Admin',
    'admin',
    TRUE,
    TRUE,
    NOW(),
    NOW()
) ON CONFLICT (id) DO UPDATE SET
    email = 'admin@test.local',
    password_hash = :'TEST_PASSWORD_HASH',
    role = 'admin',
    is_active = TRUE;

INSERT INTO _sanitization_log (action, table_name, rows_affected, executed_at)
VALUES ('test_admin_created', 'users', 1, NOW());

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ STEP 8: VERIFICATION                                                   │
-- └─────────────────────────────────────────────────────────────────────────┘

-- Verify no real password hashes remain
DO $$
DECLARE
    real_passwords_count INTEGER;
BEGIN
    SELECT COUNT(*) INTO real_passwords_count
    FROM users
    WHERE password_hash IS NOT NULL
      AND password_hash != '$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/X4.qE7f9eJmN/d/AS';
    
    IF real_passwords_count > 0 THEN
        RAISE EXCEPTION 'SANITIZATION FAILED: % users still have real password hashes', real_passwords_count;
    END IF;
END $$;

-- Verify no active MFA
DO $$
DECLARE
    active_mfa_count INTEGER;
BEGIN
    SELECT COUNT(*) INTO active_mfa_count
    FROM users
    WHERE mfa_enabled = TRUE;
    
    IF active_mfa_count > 0 THEN
        RAISE EXCEPTION 'SANITIZATION FAILED: % users still have MFA enabled', active_mfa_count;
    END IF;
END $$;

-- Verify sessions cleared
DO $$
DECLARE
    session_count INTEGER;
BEGIN
    SELECT COUNT(*) INTO session_count FROM sessions;
    
    IF session_count > 0 THEN
        RAISE EXCEPTION 'SANITIZATION FAILED: % sessions still exist', session_count;
    END IF;
END $$;

-- Final verification summary
SELECT 
    'SANITIZATION COMPLETE' AS status,
    (SELECT COUNT(*) FROM users) AS total_users,
    (SELECT COUNT(*) FROM users WHERE password_hash = :'TEST_PASSWORD_HASH') AS users_with_test_password,
    (SELECT COUNT(*) FROM users WHERE mfa_enabled = FALSE) AS users_mfa_disabled,
    (SELECT COUNT(*) FROM sessions) AS active_sessions,
    NOW() AS completed_at;

