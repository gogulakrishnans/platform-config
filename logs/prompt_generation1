### IAM Conditions for Prefix Isolation

```hcl
# ════════════════════════════════════════════════════════════════════════════
# TERRAFORM: GCS IAM WITH CONDITIONS
# ════════════════════════════════════════════════════════════════════════════

locals {
  customer_id = "acme-corp"
  bucket_name = "platform-customer-data"
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ DEV ENVIRONMENT: Write to own prefix                                   │
# └─────────────────────────────────────────────────────────────────────────┘

resource "google_storage_bucket_iam_member" "acme_dev_write_own" {
  bucket = local.bucket_name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com"

  condition {
    title       = "acme-dev-write-own-prefix"
    description = "Dev can read/write to acme-corp/dev/ prefix"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/dev/")
    EOT
  }
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ DEV ENVIRONMENT: Read shared prefix                                    │
# └─────────────────────────────────────────────────────────────────────────┘

resource "google_storage_bucket_iam_member" "acme_dev_read_shared" {
  bucket = local.bucket_name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com"

  condition {
    title       = "acme-dev-read-shared-prefix"
    description = "Dev can read acme-corp/shared/ prefix"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/shared/")
    EOT
  }
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ DEV ENVIRONMENT: Read other environments (optional, for data cloning) │
# └─────────────────────────────────────────────────────────────────────────┘

resource "google_storage_bucket_iam_member" "acme_dev_read_stage" {
  bucket = local.bucket_name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com"

  condition {
    title       = "acme-dev-read-stage-prefix"
    description = "Dev can read acme-corp/stage/ prefix"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/stage/")
    EOT
  }
}

resource "google_storage_bucket_iam_member" "acme_dev_read_prod" {
  bucket = local.bucket_name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com"

  condition {
    title       = "acme-dev-read-prod-prefix"
    description = "Dev can read acme-corp/prod/ prefix for data cloning"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/prod/")
    EOT
  }
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ PROD ENVIRONMENT: Write to own prefix ONLY                             │
# └─────────────────────────────────────────────────────────────────────────┘

resource "google_storage_bucket_iam_member" "acme_prod_write_own" {
  bucket = local.bucket_name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:acme-corp-prod@shared-compute-prod.iam.gserviceaccount.com"

  condition {
    title       = "acme-prod-write-own-prefix"
    description = "Prod can read/write to acme-corp/prod/ prefix"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/prod/")
    EOT
  }
}

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ PROD ENVIRONMENT: Read shared prefix ONLY                              │
# └─────────────────────────────────────────────────────────────────────────┘

resource "google_storage_bucket_iam_member" "acme_prod_read_shared" {
  bucket = local.bucket_name
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:acme-corp-prod@shared-compute-prod.iam.gserviceaccount.com"

  condition {
    title       = "acme-prod-read-shared-prefix"
    description = "Prod can read acme-corp/shared/ prefix"
    expression  = <<-EOT
      resource.name.startsWith("projects/_/buckets/${local.bucket_name}/objects/${local.customer_id}/shared/")
    EOT
  }
}

# ════════════════════════════════════════════════════════════════════════════
# NOTE: Prod has NO grants for dev/, stage/, uat/ prefixes
# This means Prod CANNOT access lower environment data
# ════════════════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════════════
# CROSS-CUSTOMER ISOLATION
# Beta Industries service accounts have ZERO grants on acme-corp/ prefixes
# ════════════════════════════════════════════════════════════════════════════
