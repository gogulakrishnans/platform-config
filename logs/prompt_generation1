### GitHub Actions Workflow for On-Demand Clone

```yaml
# .github/workflows/data-clone.yaml

name: Data Clone (On-Demand)

on:
  workflow_dispatch:
    inputs:
      customer:
        description: 'Customer ID (e.g., acme-corp)'
        required: true
        type: string
      target_env:
        description: 'Target environment'
        required: true
        type: choice
        options:
          - dev
          - stage
      tables:
        description: 'Tables to clone (comma-separated, or "all")'
        required: false
        default: 'all'
        type: string
      days:
        description: 'Days of data to clone'
        required: false
        default: '30'
        type: string

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - name: Validate customer exists
        run: |
          if [[ ! -d "customers/${{ inputs.customer }}" ]]; then
            echo "❌ Customer ${{ inputs.customer }} not found"
            exit 1
          fi
          echo "✅ Customer validated"
  
  clone:
    needs: validate
    runs-on: self-hosted  # Runs on GKE
    steps:
      - uses: actions/checkout@v4
      
      - name: Authenticate to GCP
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.WIF_PROVIDER }}
          service_account: ${{ secrets.DATA_CLONE_SA }}
      
      - name: Trigger clone job
        run: |
          kubectl create job data-clone-${{ github.run_id }} \
            --from=cronjob/${{ inputs.customer }}-data-clone \
            -n platform-jobs \
            -- \
            --target-schemas=${{ inputs.customer }}_${{ inputs.target_env }} \
            --tables=${{ inputs.tables }} \
            --days=${{ inputs.days }}
      
      - name: Wait for completion
        run: |
          kubectl wait --for=condition=complete \
            job/data-clone-${{ github.run_id }} \
            -n platform-jobs \
            --timeout=3600s
      
      - name: Get logs
        if: always()
        run: |
          kubectl logs job/data-clone-${{ github.run_id }} -n platform-jobs
