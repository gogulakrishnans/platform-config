## Terraform Module for Data Sharing

```hcl
# modules/customer-data-sharing/main.tf

variable "customer_id" {}
variable "environments" {
  type = list(string)
  default = ["dev", "stage", "uat", "prod"]
}
variable "data_sharing_policy" {
  type = string
  default = "nonprod-can-read-prod"
}

locals {
  policies = {
    strict = {
      dev   = ["shared"]
      stage = ["shared"]
      uat   = ["shared"]
      prod  = ["shared"]
    }
    nonprod-can-read-prod = {
      dev   = ["stage", "uat", "prod", "shared"]
      stage = ["dev", "uat", "prod", "shared"]
      uat   = ["dev", "stage", "prod", "shared"]
      prod  = ["shared"]
    }
    full-cross-env = {
      dev   = ["stage", "uat", "prod", "shared"]
      stage = ["dev", "uat", "prod", "shared"]
      uat   = ["dev", "stage", "prod", "shared"]
      prod  = ["dev", "stage", "uat", "shared"]
    }
  }
  
  selected_policy = local.policies[var.data_sharing_policy]
}

# Cloud SQL: Create schemas and permissions
resource "null_resource" "sql_schemas" {
  for_each = toset(concat(var.environments, ["shared"]))
  
  provisioner "local-exec" {
    command = <<-EOT
      gcloud sql connect ${var.sql_instance} --user=postgres <<EOF
        CREATE SCHEMA IF NOT EXISTS ${var.customer_id}_${each.key};
        CREATE USER IF NOT EXISTS ${var.customer_id}_${each.key} WITH PASSWORD '${random_password.db_passwords[each.key].result}';
      EOF
    EOT
  }
}

# Cloud SQL: Grant cross-env read permissions based on policy
resource "null_resource" "sql_cross_env_grants" {
  for_each = { for env in var.environments : env => local.selected_policy[env] }
  
  provisioner "local-exec" {
    command = <<-EOT
      gcloud sql connect ${var.sql_instance} --user=postgres <<EOF
        %{ for target_env in each.value }
        GRANT USAGE ON SCHEMA ${var.customer_id}_${target_env} TO ${var.customer_id}_${each.key};
        GRANT SELECT ON ALL TABLES IN SCHEMA ${var.customer_id}_${target_env} TO ${var.customer_id}_${each.key};
        %{ endfor }
      EOF
    EOT
  }
  
  depends_on = [null_resource.sql_schemas]
}

# BigQuery: Row access policies
resource "google_bigquery_table_iam_member" "cross_env_access" {
  for_each = { for env in var.environments : env => local.selected_policy[env] }
  
  project    = var.project_id
  dataset_id = var.bigquery_dataset
  table_id   = var.bigquery_table
  role       = "roles/bigquery.dataViewer"
  member     = "serviceAccount:${var.customer_id}-${each.key}@${var.project_id}.iam.gserviceaccount.com"
  
  # Row-level filtering applied via BigQuery row access policies (separate resource)
}

# GCS: Cross-environment read access
resource "google_storage_bucket_iam_member" "cross_env_gcs_read" {
  for_each = {
    for pair in flatten([
      for env in var.environments : [
        for target in local.selected_policy[env] : {
          env    = env
          target = target
        }
      ]
    ]) : "${pair.env}-${pair.target}" => pair
  }
  
  bucket = var.storage_bucket
  role   = "roles/storage.objectViewer"
  member = "serviceAccount:${var.customer_id}-${each.value.env}@${var.project_id}.iam.gserviceaccount.com"
  
  condition {
    title      = "${var.customer_id}-${each.value.env}-read-${each.value.target}"
    expression = "resource.name.startsWith('projects/_/buckets/${var.storage_bucket}/objects/${var.customer_id}/${each.value.target}/')"
  }
}
```

