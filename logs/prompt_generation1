### BigQuery Authorized View with Anonymization

```sql
-- ════════════════════════════════════════════════════════════════════════════
-- CREATE AUTHORIZED VIEW WITH BUILT-IN ANONYMIZATION
-- ════════════════════════════════════════════════════════════════════════════

-- Create dev dataset
CREATE SCHEMA IF NOT EXISTS `project.acme_corp_dev`;

-- Create anonymized view pointing to prod data
CREATE OR REPLACE VIEW `project.acme_corp_dev.users_anonymized` AS
SELECT
    id,
    -- Anonymize email
    CONCAT('user_', CAST(id AS STRING), '@test.local') AS email,
    -- Mask phone (keep last 4 digits)
    CONCAT('***-***-', RIGHT(phone, 4)) AS phone,
    -- Hash SSN (keep last 4 digits)
    CONCAT('XXX-XX-', RIGHT(ssn, 4)) AS ssn,
    -- Keep non-PII fields as-is
    account_type,
    status,
    created_at,
    updated_at
FROM `project.acme_corp_prod.users`
-- Optional: Filter to recent data
WHERE created_at >= DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY);

-- Grant dev service account access to the VIEW (not the underlying table)
-- The view is "authorized" to read from prod dataset

-- ════════════════════════════════════════════════════════════════════════════
-- AUTHORIZE THE VIEW TO ACCESS PROD DATASET
-- ════════════════════════════════════════════════════════════════════════════

-- In Terraform or via bq CLI:
-- bq update --view_uris="project:acme_corp_dev.users_anonymized" project:acme_corp_prod
```

