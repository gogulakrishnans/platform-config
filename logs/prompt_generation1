## Product Definition Schema

```yaml
# products/payment-api/product.yaml
# ════════════════════════════════════════════════════════════════════════════
# PRODUCT DEFINITION: payment-api
# ════════════════════════════════════════════════════════════════════════════

apiVersion: platform.company.io/v1
kind: ProductDefinition
metadata:
  name: payment-api
  labels:
    category: core
    tier: premium

spec:
  displayName: "Payment Processing API"
  description: "Secure payment processing with PCI-DSS compliance"
  version: "2.5.0"
  
  # ──────────────────────────────────────────────────────────────────────────
  # RUNTIME CONFIGURATION
  # ──────────────────────────────────────────────────────────────────────────
  runtime:
    type: gke                           # gke | cloud-run | instance-group
    
    gke:
      replicas:
        dev: 1
        stage: 2
        uat: 2
        prod: 3
      resources:
        requests:
          cpu: "500m"
          memory: "512Mi"
        limits:
          cpu: "2"
          memory: "2Gi"
      autoscaling:
        enabled: true
        minReplicas: 2
        maxReplicas: 20
        targetCPUUtilization: 70
      
  # ──────────────────────────────────────────────────────────────────────────
  # INFRASTRUCTURE REQUIREMENTS
  # This defines what infrastructure must be provisioned for this product
  # ──────────────────────────────────────────────────────────────────────────
  infrastructure:
    
    # Cloud SQL Database
    cloudSql:
      required: true
      type: postgresql
      version: "15"
      sizing:
        dev:
          tier: db-f1-micro
          diskSizeGb: 10
        stage:
          tier: db-custom-1-3840
          diskSizeGb: 20
        uat:
          tier: db-custom-2-7680
          diskSizeGb: 50
        prod:
          tier: db-custom-4-15360
          diskSizeGb: 100
          highAvailability: true
          backupEnabled: true
      databases:
        - name: payments
          charset: UTF8
      users:
        - name: payment_app
          type: application
        - name: payment_readonly
          type: readonly
    
    # Redis Cache
    redis:
      required: true
      sizing:
        dev:
          tier: BASIC
          memorySizeGb: 1
        stage:
          tier: BASIC
          memorySizeGb: 2
        uat:
          tier: STANDARD_HA
          memorySizeGb: 2
        prod:
          tier: STANDARD_HA
          memorySizeGb: 5
    
    # Cloud Storage
    storage:
      required: true
      buckets:
        - name: uploads
          purpose: "Customer file uploads"
          lifecycle:
            deleteAfterDays: 90
        - name: exports
          purpose: "Payment reports"
          lifecycle:
            archiveAfterDays: 30
            deleteAfterDays: 365
    
    # Pub/Sub
    pubsub:
      required: true
      topics:
        - name: payment-events
          purpose: "Payment lifecycle events"
          subscriptions:
            - name: payment-processor
              ackDeadlineSeconds: 60
            - name: audit-logger
              ackDeadlineSeconds: 30
        - name: payment-webhooks
          purpose: "Webhook delivery"
          subscriptions:
            - name: webhook-sender
              ackDeadlineSeconds: 120
              deadLetterTopic: true
    
    # Cloud KMS
    kms:
      required: true
      purpose: "Payment data encryption"
      keyRings:
        - name: payment-keys
          keys:
            - name: card-encryption
              purpose: ENCRYPT_DECRYPT
              rotationPeriod: "7776000s"  # 90 days
            - name: pii-encryption
              purpose: ENCRYPT_DECRYPT
              rotationPeriod: "7776000s"
    
    # Secret Manager
    secrets:
      required: true
      secrets:
        - name: stripe-api-key
          description: "Stripe API credentials"
        - name: payment-signing-key
          description: "Request signing key"
    
    # BigQuery (Optional for this product)
    bigQuery:
      required: false
    
    # Cloud Tasks (Not needed)
    cloudTasks:
      required: false
    
  # ──────────────────────────────────────────────────────────────────────────
  # NETWORKING REQUIREMENTS
  # ──────────────────────────────────────────────────────────────────────────
  networking:
    ingress:
      enabled: true
      public: true                      # Internet-facing in prod
      path: /api/v1/payments
    
    egress:
      allowedDestinations:
        - api.stripe.com
        - api.paypal.com
        - hooks.slack.com
    
    serviceMesh:
      mtls: STRICT
      
  # ──────────────────────────────────────────────────────────────────────────
  # DEPENDENCIES ON OTHER PRODUCTS
  # ──────────────────────────────────────────────────────────────────────────
  dependencies:
    required: []                        # No hard dependencies
    optional:
      - name: notification-service
        purpose: "Payment confirmation notifications"
      - name: audit-service
        purpose: "Payment audit logging"
  
  # ──────────────────────────────────────────────────────────────────────────
  # COMPLIANCE & SECURITY
  # ──────────────────────────────────────────────────────────────────────────
  compliance:
    pciDss: true
    dataClassification: sensitive
    encryptionRequired: true
    auditLogging: true
    
  # ──────────────────────────────────────────────────────────────────────────
  # COST METADATA
  # ──────────────────────────────────────────────────────────────────────────
  cost:
    baseMonthly:
      dev: 50
      stage: 100
      uat: 150
      prod: 500
    perUserMonthly: 0.10
```

