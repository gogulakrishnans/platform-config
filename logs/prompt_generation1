## Terraform Implementation: Dynamic Product Infrastructure

```hcl
# ════════════════════════════════════════════════════════════════════════════
# infrastructure/modules/customer-infrastructure/main.tf
# DYNAMIC INFRASTRUCTURE BASED ON PRODUCT SELECTION
# ════════════════════════════════════════════════════════════════════════════

variable "customer_id" {
  type = string
}

variable "environment" {
  type = string
}

variable "products" {
  type = map(object({
    enabled = bool
    version = string
    infrastructure_overrides = optional(map(any), {})
  }))
}

variable "product_definitions" {
  type = map(any)
  description = "Product definitions loaded from YAML"
}

# ──────────────────────────────────────────────────────────────────────────
# LOCAL: Compute which infrastructure components are needed
# ──────────────────────────────────────────────────────────────────────────

locals {
  # Filter to only enabled products
  enabled_products = {
    for name, config in var.products : name => config
    if config.enabled
  }
  
  # Determine if each infrastructure type is needed
  needs_cloud_sql = anytrue([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.cloudSql.required
  ])
  
  needs_redis = anytrue([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.redis.required
  ])
  
  needs_bigquery = anytrue([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.bigQuery.required
  ])
  
  needs_pubsub = anytrue([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.pubsub.required
  ])
  
  needs_kms = anytrue([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.kms.required
  ])
  
  needs_cloud_scheduler = anytrue([
    for name, _ in local.enabled_products :
    try(var.product_definitions[name].infrastructure.cloudScheduler.required, false)
  ])
  
  # Collect all storage buckets from all enabled products
  storage_buckets = flatten([
    for name, _ in local.enabled_products : [
      for bucket in var.product_definitions[name].infrastructure.storage.buckets : {
        product = name
        name    = "${var.customer_id}-${name}-${bucket.name}"
        purpose = bucket.purpose
        lifecycle = bucket.lifecycle
      }
    ]
    if var.product_definitions[name].infrastructure.storage.required
  ])
  
  # Collect all Pub/Sub topics from all enabled products
  pubsub_topics = flatten([
    for name, _ in local.enabled_products : [
      for topic in try(var.product_definitions[name].infrastructure.pubsub.topics, []) : {
        product = name
        name    = "${var.customer_id}-${name}-${topic.name}"
        purpose = topic.purpose
        subscriptions = topic.subscriptions
      }
    ]
    if try(var.product_definitions[name].infrastructure.pubsub.required, false)
  ])
  
  # Collect all BigQuery datasets from all enabled products
  bigquery_datasets = flatten([
    for name, _ in local.enabled_products : [
      for dataset in try(var.product_definitions[name].infrastructure.bigQuery.datasets, []) : {
        product  = name
        name     = "${var.customer_id}_${name}_${dataset.name}"
        location = dataset.location
        tables   = try(dataset.tables, [])
      }
    ]
    if try(var.product_definitions[name].infrastructure.bigQuery.required, false)
  ])
}

# ──────────────────────────────────────────────────────────────────────────
# CLOUD SQL: Provision only if any product needs it
# ──────────────────────────────────────────────────────────────────────────

module "cloud_sql" {
  source = "../cloud-sql"
  count  = local.needs_cloud_sql ? 1 : 0
  
  customer_id = var.customer_id
  environment = var.environment
  
  # Find the product that needs Cloud SQL and get its config
  config = {
    for name, _ in local.enabled_products :
    name => merge(
      var.product_definitions[name].infrastructure.cloudSql.sizing[var.environment],
      try(var.products[name].infrastructure_overrides.cloudSql[var.environment], {})
    )
    if var.product_definitions[name].infrastructure.cloudSql.required
  }
}

# ──────────────────────────────────────────────────────────────────────────
# REDIS: Provision only if any product needs it
# ──────────────────────────────────────────────────────────────────────────

module "redis" {
  source = "../redis"
  count  = local.needs_redis ? 1 : 0
  
  customer_id = var.customer_id
  environment = var.environment
  
  config = {
    for name, _ in local.enabled_products :
    name => merge(
      var.product_definitions[name].infrastructure.redis.sizing[var.environment],
      try(var.products[name].infrastructure_overrides.redis[var.environment], {})
    )
    if var.product_definitions[name].infrastructure.redis.required
  }
}

# ──────────────────────────────────────────────────────────────────────────
# BIGQUERY: Provision only if any product needs it
# ──────────────────────────────────────────────────────────────────────────

module "bigquery" {
  source   = "../bigquery"
  for_each = local.needs_bigquery ? toset(local.bigquery_datasets[*].name) : []
  
  customer_id = var.customer_id
  environment = var.environment
  dataset     = [for d in local.bigquery_datasets : d if d.name == each.key][0]
}

# ──────────────────────────────────────────────────────────────────────────
# CLOUD STORAGE: Provision all buckets from all enabled products
# ──────────────────────────────────────────────────────────────────────────

module "storage" {
  source   = "../storage"
  for_each = { for bucket in local.storage_buckets : bucket.name => bucket }
  
  customer_id = var.customer_id
  environment = var.environment
  bucket      = each.value
}

# ──────────────────────────────────────────────────────────────────────────
# PUB/SUB: Provision all topics from all enabled products
# ──────────────────────────────────────────────────────────────────────────

module "pubsub" {
  source   = "../pubsub"
  for_each = { for topic in local.pubsub_topics : topic.name => topic }
  
  customer_id = var.customer_id
  environment = var.environment
  topic       = each.value
}

# ──────────────────────────────────────────────────────────────────────────
# KMS: Provision only if any product needs it
# ──────────────────────────────────────────────────────────────────────────

module "kms" {
  source = "../kms"
  count  = local.needs_kms ? 1 : 0
  
  customer_id = var.customer_id
  environment = var.environment
  
  key_rings = flatten([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.kms.keyRings
    if try(var.product_definitions[name].infrastructure.kms.required, false)
  ])
}

# ──────────────────────────────────────────────────────────────────────────
# CLOUD SCHEDULER: Provision only if any product needs it
# ──────────────────────────────────────────────────────────────────────────

module "cloud_scheduler" {
  source = "../cloud-scheduler"
  count  = local.needs_cloud_scheduler ? 1 : 0
  
  customer_id = var.customer_id
  environment = var.environment
  
  jobs = flatten([
    for name, _ in local.enabled_products :
    var.product_definitions[name].infrastructure.cloudScheduler.jobs
    if try(var.product_definitions[name].infrastructure.cloudScheduler.required, false)
  ])
}

# ──────────────────────────────────────────────────────────────────────────
# OUTPUTS
# ──────────────────────────────────────────────────────────────────────────

output "provisioned_infrastructure" {
  value = {
    cloud_sql       = local.needs_cloud_sql
    redis           = local.needs_redis
    bigquery        = local.needs_bigquery
    pubsub          = local.needs_pubsub
    kms             = local.needs_kms
    cloud_scheduler = local.needs_cloud_scheduler
    
    storage_buckets = [for b in local.storage_buckets : b.name]
    pubsub_topics   = [for t in local.pubsub_topics : t.name]
    bigquery_datasets = [for d in local.bigquery_datasets : d.name]
    
    enabled_products = keys(local.enabled_products)
  }
}
```

