### BigQuery Cost Allocation Query

```sql
-- Monthly cost allocation per customer
WITH 
  -- Direct costs from billing export
  direct_costs AS (
    SELECT 
      labels.value AS customer,
      SUM(cost) AS direct_cost
    FROM `billing_export.gcp_billing_export_v1_*`
    WHERE labels.key = 'customer'
      AND invoice.month = FORMAT_DATE('%Y%m', CURRENT_DATE())
    GROUP BY customer
  ),
  
  -- Cluster usage from GKE metering
  cluster_usage AS (
    SELECT
      SPLIT(namespace, '-')[OFFSET(0)] AS customer,
      cluster_name,
      SUM(cpu_request_seconds) AS cpu_seconds,
      SUM(memory_request_byte_seconds) AS memory_byte_seconds
    FROM `platform-billing.gke_usage_metering.gke_cluster_resource_usage`
    WHERE _PARTITIONTIME >= DATE_TRUNC(CURRENT_DATE(), MONTH)
    GROUP BY customer, cluster_name
  ),
  
  -- Total cluster costs
  cluster_costs AS (
    SELECT
      CASE 
        WHEN project_id LIKE '%nonprod%' THEN 'nonprod'
        ELSE 'prod'
      END AS cluster_type,
      SUM(cost) AS total_cost
    FROM `billing_export.gcp_billing_export_v1_*`
    WHERE service.description = 'Kubernetes Engine'
      AND invoice.month = FORMAT_DATE('%Y%m', CURRENT_DATE())
    GROUP BY cluster_type
  ),
  
  -- Customer allocation percentages
  allocation AS (
    SELECT
      customer,
      cluster_name,
      cpu_seconds / SUM(cpu_seconds) OVER (PARTITION BY cluster_name) AS cpu_share,
      memory_byte_seconds / SUM(memory_byte_seconds) OVER (PARTITION BY cluster_name) AS memory_share
    FROM cluster_usage
  )

SELECT
  c.customer,
  c.tier,
  COALESCE(d.direct_cost, 0) AS direct_costs,
  SUM(a.cpu_share * 0.5 + a.memory_share * 0.5) * cc.total_cost AS compute_allocation,
  pf.platform_fee,
  COALESCE(d.direct_cost, 0) 
    + SUM(a.cpu_share * 0.5 + a.memory_share * 0.5) * cc.total_cost 
    + pf.platform_fee AS total_cost
FROM `platform-config.customers` c
LEFT JOIN direct_costs d ON c.customer = d.customer
LEFT JOIN allocation a ON c.customer = a.customer
LEFT JOIN cluster_costs cc ON TRUE
LEFT JOIN `platform-config.platform_fees` pf ON c.tier = pf.tier
GROUP BY c.customer, c.tier, d.direct_cost, pf.platform_fee
ORDER BY total_cost DESC;
```

