#### Data Clone Tool Logic (Python)

```python
# data_clone_tool.py

import os
import hashlib
from faker import Faker
import psycopg2
from psycopg2 import sql

fake = Faker()

class DataCloneTool:
    def __init__(self):
        self.tenant_id = os.environ['TENANT_ID']
        self.source_env = os.environ['SOURCE_ENV']
        self.target_envs = os.environ['TARGET_ENVS'].split(',')
        self.tables = os.environ['TABLES'].split(',')
        self.anonymize = os.environ.get('ANONYMIZE', 'true').lower() == 'true'
        self.anonymize_columns = self._parse_anonymize_columns()
        self.date_filter_days = int(os.environ.get('DATE_FILTER_DAYS', 30))
        
    def _parse_anonymize_columns(self):
        """Parse ANONYMIZE_COLUMNS env var into dict"""
        columns = os.environ.get('ANONYMIZE_COLUMNS', '').split(',')
        result = {}
        for col in columns:
            if '.' in col:
                table, column = col.split('.')
                if table not in result:
                    result[table] = []
                result[table].append(column)
        return result
    
    def _anonymize_value(self, column_name, value):
        """Anonymize a value based on column type"""
        if value is None:
            return None
            
        if 'email' in column_name.lower():
            return fake.email()
        elif 'phone' in column_name.lower():
            return fake.phone_number()
        elif 'ssn' in column_name.lower():
            return hashlib.sha256(str(value).encode()).hexdigest()[:11]
        elif 'name' in column_name.lower():
            return fake.name()
        elif 'address' in column_name.lower():
            return fake.address()
        else:
            # Default: hash the value
            return hashlib.sha256(str(value).encode()).hexdigest()[:len(str(value))]
    
    def clone_table(self, conn, table, source_schema, target_schema):
        """Clone a single table with optional anonymization"""
        
        with conn.cursor() as cur:
            # Get column names
            cur.execute(sql.SQL("""
                SELECT column_name 
                FROM information_schema.columns 
                WHERE table_schema = %s AND table_name = %s
                ORDER BY ordinal_position
            """), [source_schema, table])
            columns = [row[0] for row in cur.fetchall()]
            
            # Build date filter
            date_filter = ""
            if self.date_filter_days > 0:
                date_filter = f"WHERE created_at >= CURRENT_DATE - INTERVAL '{self.date_filter_days} days'"
            
            # Fetch source data
            cur.execute(sql.SQL("""
                SELECT * FROM {}.{} {}
            """).format(
                sql.Identifier(source_schema),
                sql.Identifier(table),
                sql.SQL(date_filter)
            ))
            rows = cur.fetchall()
            
            # Truncate target table
            cur.execute(sql.SQL("TRUNCATE TABLE {}.{}").format(
                sql.Identifier(target_schema),
                sql.Identifier(table)
            ))
            
            # Insert with optional anonymization
            anonymize_cols = self.anonymize_columns.get(table, [])
            
            for row in rows:
                new_row = list(row)
                
                if self.anonymize:
                    for i, col in enumerate(columns):
                        if col in anonymize_cols:
                            new_row[i] = self._anonymize_value(col, row[i])
                
                placeholders = ', '.join(['%s'] * len(columns))
                col_names = ', '.join([f'"{c}"' for c in columns])
                
                cur.execute(sql.SQL(f"""
                    INSERT INTO {{}}.{{}} ({col_names}) VALUES ({placeholders})
                """).format(
                    sql.Identifier(target_schema),
                    sql.Identifier(table)
                ), new_row)
            
            conn.commit()
            print(f"Cloned {len(rows)} rows from {source_schema}.{table} to {target_schema}.{table}")
    
    def run(self):
        """Main execution"""
        conn = psycopg2.connect(
            host=os.environ['DB_HOST'],
            user=os.environ['DB_ADMIN_USER'],
            password=os.environ['DB_ADMIN_PASSWORD'],
            dbname='postgres'
        )
        
        source_schema = f"{self.tenant_id}_{self.source_env}"
        
        for target_env in self.target_envs:
            target_schema = f"{self.tenant_id}_{target_env}"
            print(f"\n=== Cloning {source_schema} → {target_schema} ===")
            
            for table in self.tables:
                self.clone_table(conn, table, source_schema, target_schema)
        
        conn.close()
        print("\n✅ Data clone completed successfully")

if __name__ == "__main__":
    tool = DataCloneTool()
    tool.run()
