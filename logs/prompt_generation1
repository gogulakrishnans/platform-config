### Row-Level Security Policies

```sql
-- ════════════════════════════════════════════════════════════════════════════
-- BIGQUERY ROW ACCESS POLICIES
-- ════════════════════════════════════════════════════════════════════════════

-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ ACME CORP: Non-Prod Service Accounts                                   │
-- │ Can see ALL Acme environments (for debugging, testing)                 │
-- └─────────────────────────────────────────────────────────────────────────┘

CREATE ROW ACCESS POLICY acme_corp_nonprod_access
ON `shared-analytics.platform_events.events`
GRANT TO (
    'serviceAccount:acme-corp-dev@shared-compute-nonprod.iam.gserviceaccount.com',
    'serviceAccount:acme-corp-stage@shared-compute-nonprod.iam.gserviceaccount.com',
    'serviceAccount:acme-corp-uat@shared-compute-nonprod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'acme-corp');
-- Result: These SAs can see rows evt-001 through evt-005 (all Acme rows)


-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ ACME CORP: Prod Service Account                                        │
-- │ Can see ONLY prod environment (strict isolation)                       │
-- └─────────────────────────────────────────────────────────────────────────┘

CREATE ROW ACCESS POLICY acme_corp_prod_access
ON `shared-analytics.platform_events.events`
GRANT TO (
    'serviceAccount:acme-corp-prod@shared-compute-prod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'acme-corp' AND environment = 'prod');
-- Result: This SA can see ONLY rows evt-001, evt-002 (Acme prod rows)


-- ┌─────────────────────────────────────────────────────────────────────────┐
-- │ BETA INDUSTRIES: All Service Accounts                                  │
-- │ Can see ONLY Beta data (completely isolated from Acme)                │
-- └─────────────────────────────────────────────────────────────────────────┘

CREATE ROW ACCESS POLICY beta_ind_nonprod_access
ON `shared-analytics.platform_events.events`
GRANT TO (
    'serviceAccount:beta-ind-dev@shared-compute-nonprod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'beta-ind');
-- Result: This SA can see ONLY rows evt-006, evt-007 (Beta rows)
-- ❌ CANNOT see evt-001 through evt-005 (Acme rows)

CREATE ROW ACCESS POLICY beta_ind_prod_access
ON `shared-analytics.platform_events.events`
GRANT TO (
    'serviceAccount:beta-ind-prod@shared-compute-prod.iam.gserviceaccount.com'
)
FILTER USING (tenant_id = 'beta-ind' AND environment = 'prod');
-- Result: This SA can see ONLY row evt-006 (Beta prod)
```

